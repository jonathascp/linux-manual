  },
  {
    "id": "ctrl-shift-v",
    "categoria": "atalhos-terminal",
    "comando": "Ctrl + Shift + V",
    "descricao": "Cola texto no terminal (o Ctrl+V normal não funciona no terminal).",
    "exemplo": "Ctrl + Shift + V"
  },
  {
    "id": "ctrl-a",
    "categoria": "atalhos-terminal",
    "comando": "Ctrl + A",
    "descricao": "Vai para o início da linha atual no terminal.",
