  },
  {
    "id": "ctrl-e",
    "categoria": "atalhos-terminal",
    "comando": "Ctrl + E",
    "descricao": "Vai para o fim da linha atual no terminal.",
    "exemplo": "Ctrl + E"
  },
  {
    "id": "ctrl-u",
    "categoria": "atalhos-terminal",
    "comando": "Ctrl + U",
    "descricao": "Apaga toda a linha atual digitada no terminal.",
    "exemplo": "Ctrl + U"
  },
  {
    "id": "ctrl-z",
    "categoria": "atalhos-terminal",
    "comando": "Ctrl + Z",
    "descricao": "Pausa o processo em execução no terminal.",
    "exemplo": "Ctrl + Z"
  },
  {
    "id": "ctrl-r",
    "categoria": "atalhos-terminal",
    "comando": "Ctrl + R",
    "descricao": "Busca reversa no histórico: comece a digitar parte de um comando já usado e ele aparece automaticamente.",
    "exemplo": "Ctrl + R"
  },
  {
    "id": "inxi",
    "categoria": "hardware",
    "comando": "sudo inxi -Fxz",
    "descricao": "Visão geral completa do hardware: CPU, memória, GPU, disco, rede — tudo de uma vez.",
    "exemplo": "sudo inxi -Fxz"
  },
  {
    "id": "lscpu",
    "categoria": "hardware",
    "comando": "lscpu",
    "descricao": "Mostra modelo do processador, núcleos, velocidade e arquitetura.",
    "exemplo": "lscpu"
  },
  {
    "id": "dmidecode-memory",
    "categoria": "hardware",
    "comando": "sudo dmidecode -t memory",
    "descricao": "Mostra detalhes das memórias RAM instaladas: tipo, velocidade e tamanho de cada pente.",
    "exemplo": "sudo dmidecode -t memory | grep -E \"Size|Type|Speed\""
  },
  {
    "id": "dmidecode-baseboard",
    "categoria": "hardware",
    "comando": "sudo dmidecode -t baseboard",
    "descricao": "Mostra fabricante, modelo e versão da placa-mãe.",
    "exemplo": "sudo dmidecode -t baseboard"
  },
  {
    "id": "lspci-vga",
    "categoria": "hardware",
    "comando": "lspci | grep -i vga",
    "descricao": "Mostra qual placa de vídeo (GPU) está instalada.",
    "exemplo": "lspci | grep -i vga"
  },
  {
    "id": "lsblk",
    "categoria": "hardware",
    "comando": "lsblk",
    "descricao": "Lista todos os discos e partições com seus tamanhos.",
    "exemplo": "lsblk"
  },
  {
    "id": "lshw",
    "categoria": "hardware",
    "comando": "sudo lshw -short",
    "descricao": "Lista todo o hardware em formato resumido — equivalente ao Gerenciador de Dispositivos do Windows.",
    "exemplo": "sudo lshw -short"
  },
  {
    "id": "ip-addr",
    "categoria": "rede",
    "comando": "ip addr show",
    "descricao": "Mostra todas as interfaces de rede e os IPs atribuídos a cada uma. Substituto moderno do ifconfig.",
    "exemplo": "ip a"
  },
  {
    "id": "ip-link",
    "categoria": "rede",
    "comando": "ip link show",
    "descricao": "Mostra as interfaces de rede sem IPs — foca no estado físico (up/down), MAC address e MTU.",
    "exemplo": "ip link show"
  },
  {
    "id": "ip-route",
    "categoria": "rede",
    "comando": "ip route show",
    "descricao": "Mostra a tabela de rotas: por onde o tráfego é enviado dependendo do destino. 'default via' é a rota padrão (gateway).",
    "exemplo": "ip r"
  },
  {
    "id": "ip-route-add",
    "categoria": "rede",
    "comando": "sudo ip route add",
    "descricao": "Adiciona uma rota manualmente na tabela de roteamento.",
    "exemplo": "sudo ip route add 10.0.0.0/24 via 192.168.1.1"
  },
  {
    "id": "ip-route-del",
    "categoria": "rede",
    "comando": "sudo ip route del",
    "descricao": "Remove uma rota manualmente da tabela de roteamento.",
    "exemplo": "sudo ip route del 10.0.0.0/24"
  },
  {
    "id": "ping",
    "categoria": "rede",
    "comando": "ping",
    "descricao": "Testa se um host responde e mede a latência. Use -c para limitar o número de pacotes.",
    "exemplo": "ping -c 4 8.8.8.8"
  },
  {
    "id": "traceroute",
    "categoria": "rede",
    "comando": "traceroute",
    "descricao": "Mostra o caminho (cada salto/roteador) que os pacotes percorrem até o destino. Bom para achar onde a conexão trava.",
    "exemplo": "traceroute google.com"
  },
  {
    "id": "mtr",
    "categoria": "rede",
    "comando": "mtr",
    "descricao": "Combina ping e traceroute em tempo real, atualizando continuamente. Útil para diagnosticar instabilidade.",
    "exemplo": "mtr google.com"
  },
  {
    "id": "dig",
    "categoria": "rede",
    "comando": "dig",
    "descricao": "Consulta o DNS para descobrir qual IP corresponde a um domínio.",
    "exemplo": "dig google.com"
  },
  {
    "id": "nslookup",
    "categoria": "rede",
    "comando": "nslookup",
    "descricao": "Mesma função do dig, mas com uma saída mais simples de ler para iniciantes.",
    "exemplo": "nslookup google.com"
  },
  {
    "id": "resolvectl",
    "categoria": "rede",
    "comando": "resolvectl status",
    "descricao": "Mostra quais servidores DNS estão configurados na máquina.",
    "exemplo": "resolvectl status"
  },
  {
    "id": "ss",
    "categoria": "rede",
    "comando": "ss -tulnp",
    "descricao": "Lista conexões de rede ativas e portas abertas na máquina. Substituiu o antigo netstat.",
    "exemplo": "ss -tulnp"
  },
  {
    "id": "nmcli-status",
    "categoria": "rede",
    "comando": "nmcli device status",
    "descricao": "Mostra o estado geral das interfaces de rede pela linha de comando.",
    "exemplo": "nmcli device status"
  },
  {
    "id": "nmcli-wifi-list",
    "categoria": "rede",
    "comando": "nmcli device wifi list",
    "descricao": "Lista as redes Wi-Fi disponíveis.",
    "exemplo": "nmcli device wifi list"
  },
  {
    "id": "nmcli-wifi-connect",
    "categoria": "rede",
    "comando": "nmcli device wifi connect",
    "descricao": "Conecta a uma rede Wi-Fi pelo terminal, sem abrir a interface gráfica.",
    "exemplo": "nmcli device wifi connect \"NomeDaRede\" password \"senha123\""
  },
  {
    "id": "wildcard-asterisco",
    "categoria": "wildcards",
    "comando": "*",
    "descricao": "Substitui qualquer sequência de caracteres (zero ou mais). O curinga mais usado.",
    "exemplo": "ls *.txt"
  },
  {
    "id": "wildcard-interrogacao",
    "categoria": "wildcards",
    "comando": "?",
    "descricao": "Substitui exatamente um caractere, nem mais nem menos.",
    "exemplo": "ls foto?.jpg"
  },
  {
    "id": "wildcard-colchetes",
    "categoria": "wildcards",
    "comando": "[ ]",
    "descricao": "Combina com um único caractere dentre um conjunto específico. Aceita intervalos (a-z) e negação (!).",
    "exemplo": "ls foto[123].jpg"
  },
  {
    "id": "wildcard-chaves",
    "categoria": "wildcards",
    "comando": "{ }",
    "descricao": "Expansão de chaves: gera múltiplas strings de uma vez, antes de qualquer busca de arquivo.",
    "exemplo": "cp relatorio.{doc,pdf,txt} ~/backup/"
  },
  {
    "id": "cp-r-asterisco",
    "categoria": "wildcards",
    "comando": "cp -r origem/* destino/",
    "descricao": "Copia todo o conteúdo visível de uma pasta. Não pega arquivos ocultos (os que começam com ponto).",
    "exemplo": "cp -r /origem/* /destino/"
  },
  {
    "id": "cp-r-ponto",
    "categoria": "wildcards",
    "comando": "cp -r origem/. destino/",
    "descricao": "Copia todo o conteúdo de uma pasta, incluindo arquivos ocultos (diferente do *).",
    "exemplo": "cp -r /origem/. /destino/"
  },
  {
    "id": "rsync",
    "categoria": "wildcards",
    "comando": "rsync -av",
    "descricao": "Alternativa mais segura ao cp para clonar uma pasta inteira, preservando permissões e datas.",
    "exemplo": "rsync -av ~/origem/ ~/destino/"
  },
  {
    "id": "find",
    "categoria": "wildcards",
    "comando": "find",
    "descricao": "Busca arquivos em subpastas, com filtros por nome, data ou tamanho.",
    "exemplo": "find . -name \"*.pdf\""
  },
  {
    "id": "grep-arquivos",
    "categoria": "wildcards",
    "comando": "grep -l",
    "descricao": "Busca arquivos pelo conteúdo dentro deles, não pelo nome.",
    "exemplo": "grep -l \"erro\" *.log"
  },
  {
    "id": "chmod-script",
    "categoria": "sistema",
    "comando": "chmod +x",
    "descricao": "Dá permissão de execução a um arquivo. No Linux, arquivos não são executáveis por padrão.",
    "exemplo": "chmod +x ~/projetos/ola.sh"
  },
  {
    "id": "executar-script",
    "categoria": "sistema",
    "comando": "./script.sh",
    "descricao": "Executa um script depois de dar permissão com chmod +x.",
    "exemplo": "./projetos/ola.sh"
  },
  {
    "id": "firefox-pathutils",
    "categoria": "personalizacao",
    "comando": "PathUtils.join (Console do Firefox)",
    "descricao": "Retorna o caminho exato onde o Firefox espera o arquivo userChrome.css, independente da versão ou perfil ativo.",
    "exemplo": "PathUtils.join(PathUtils.profileDir, \"chrome\", \"userChrome.css\")"
  },
  {
    "id": "firefox-toggle-css",
    "categoria": "personalizacao",
