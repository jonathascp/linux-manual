[
  {
    "id": "pwd",
    "categoria": "navegacao",
    "comando": "pwd",
    "descricao": "Mostra o caminho completo da pasta atual.",
    "exemplo": "pwd"
  },
  {
    "id": "cd",
    "categoria": "navegacao",
    "comando": "cd",
    "descricao": "Vai para uma pasta específica.",
    "exemplo": "cd /caminho"
  },
  {
    "id": "cd-voltar",
    "categoria": "navegacao",
    "comando": "cd ..",
    "descricao": "Volta uma pasta (para a pasta pai).",
    "exemplo": "cd .."
  },
  {
    "id": "cd-home",
    "categoria": "navegacao",
    "comando": "cd ~",
    "descricao": "Vai direto para a pasta pessoal do usuário.",
    "exemplo": "cd ~"
  },
  {
    "id": "ls",
    "categoria": "navegacao",
    "comando": "ls",
    "descricao": "Lista os arquivos e pastas do diretório atual.",
    "exemplo": "ls"
  },
  {
    "id": "ls-la",
    "categoria": "navegacao",
    "comando": "ls -la",
    "descricao": "Lista arquivos com detalhes (permissões, dono, tamanho) e incluindo arquivos ocultos.",
    "exemplo": "ls -la"
  },
  {
    "id": "touch",
    "categoria": "arquivos",
    "comando": "touch",
    "descricao": "Cria um arquivo vazio.",
    "exemplo": "touch arquivo.txt"
  },
  {
    "id": "mkdir",
    "categoria": "arquivos",
    "comando": "mkdir",
    "descricao": "Cria uma pasta nova.",
    "exemplo": "mkdir ~/projetos"
  },
  {
    "id": "rm",
    "categoria": "arquivos",
    "comando": "rm",
    "descricao": "Apaga um arquivo. Cuidado: não manda para lixeira, é permanente.",
    "exemplo": "rm arquivo.txt"
  },
  {
    "id": "nano",
    "categoria": "arquivos",
    "comando": "nano",
    "descricao": "Abre um editor de texto simples direto no terminal.",
    "exemplo": "nano arquivo.txt"
  },
  {
    "id": "cp",
    "categoria": "arquivos",
    "comando": "cp",
    "descricao": "Copia um arquivo (o original continua no lugar).",
    "exemplo": "cp arquivo.txt ~/Documentos/"
  },
  {
    "id": "cp-r",
    "categoria": "arquivos",
    "comando": "cp -r",
    "descricao": "Copia uma pasta inteira. O -r (recursivo) é obrigatório para pastas.",
    "exemplo": "cp -r pasta/ ~/Documentos/"
  },
  {
    "id": "mv",
    "categoria": "arquivos",
    "comando": "mv",
    "descricao": "Move um arquivo (recorta e cola). Também serve para renomear.",
    "exemplo": "mv arquivo.txt ~/Documentos/"
  },
  {
    "id": "mv-renomear",
    "categoria": "arquivos",
    "comando": "mv (renomear)",
    "descricao": "Usa o mv para renomear um arquivo, informando o nome novo no lugar do destino.",
    "exemplo": "mv nomeantigo.txt nomenovo.txt"
  },
  {
    "id": "nemo",
    "categoria": "arquivos",
    "comando": "nemo .",
    "descricao": "Abre a pasta atual no gerenciador de arquivos gráfico (Nemo, padrão do Mint).",
    "exemplo": "nemo ."
  },
  {
    "id": "xdg-open",
    "categoria": "arquivos",
    "comando": "xdg-open",
    "descricao": "Abre um arquivo ou pasta com o programa padrão do sistema. Funciona em qualquer distro Linux.",
    "exemplo": "xdg-open ."
  },
  {
    "id": "df",
    "categoria": "sistema",
    "comando": "df -h",
    "descricao": "Mostra o espaço usado e disponível no HD/SSD, em formato legível (GB/MB).",
    "exemplo": "df -h"
  },
  {
    "id": "free",
    "categoria": "sistema",
    "comando": "free -h",
    "descricao": "Mostra quanto de memória RAM está instalada e em uso.",
    "exemplo": "free -h"
  },
  {
    "id": "top",
    "categoria": "sistema",
    "comando": "top",
    "descricao": "Monitor de processos em tempo real. Ctrl+C para sair.",
    "exemplo": "top"
  },
  {
    "id": "history",
    "categoria": "sistema",
    "comando": "history",
    "descricao": "Mostra a lista numerada de todos os comandos já digitados no terminal.",
    "exemplo": "history"
  },
  {
    "id": "clear",
    "categoria": "sistema",
    "comando": "clear",
    "descricao": "Limpa a tela do terminal.",
    "exemplo": "clear"
  },
  {
    "id": "which",
    "categoria": "sistema",
    "comando": "which",
    "descricao": "Mostra o caminho do executável de um programa, confirmando que ele existe.",
    "exemplo": "which nome-do-programa"
  },
  {
    "id": "whereis",
    "categoria": "sistema",
    "comando": "whereis",
    "descricao": "Parecido com o which, mas também mostra manual e arquivos de configuração.",
    "exemplo": "whereis nome-do-programa"
  },
  {
    "id": "apropos",
    "categoria": "sistema",
    "comando": "apropos",
    "descricao": "Busca nas descrições de todos os manuais instalados — útil quando não lembra o nome do comando, só o que ele faz.",
    "exemplo": "apropos compress"
  },
  {
    "id": "alias",
    "categoria": "sistema",
    "comando": "alias",
    "descricao": "Cria um apelido para um comando longo, editando o arquivo ~/.bashrc. Depois de salvar, rode 'source ~/.bashrc' para funcionar.",
    "exemplo": "alias abrirpastas='nemo .'"
  },
  {
    "id": "apt-update",
    "categoria": "pacotes",
    "comando": "sudo apt update",
    "descricao": "Atualiza a lista de programas disponíveis nos repositórios. Sempre rodar antes de instalar algo.",
    "exemplo": "sudo apt update && sudo apt upgrade"
  },
  {
    "id": "apt-upgrade",
    "categoria": "pacotes",
    "comando": "sudo apt upgrade",
    "descricao": "Atualiza todos os programas já instalados para a versão mais recente.",
    "exemplo": "sudo apt upgrade"
  },
  {
    "id": "apt-install",
    "categoria": "pacotes",
    "comando": "sudo apt install",
    "descricao": "Instala um ou mais programas pelo nome.",
    "exemplo": "sudo apt install prog1 prog2 prog3"
  },
  {
    "id": "apt-remove",
    "categoria": "pacotes",
    "comando": "sudo apt remove",
    "descricao": "Remove um programa, mas mantém os arquivos de configuração.",
    "exemplo": "sudo apt remove nomedoprograma"
  },
  {
    "id": "apt-purge",
    "categoria": "pacotes",
    "comando": "sudo apt purge",
    "descricao": "Remove um programa completamente, incluindo as configurações.",
    "exemplo": "sudo apt purge nomedoprograma"
  },
  {
    "id": "apt-autoremove",
    "categoria": "pacotes",
    "comando": "sudo apt autoremove",
    "descricao": "Remove dependências que não são mais necessárias por nenhum programa instalado.",
    "exemplo": "sudo apt autoremove"
  },
  {
    "id": "apt-search",
    "categoria": "pacotes",
    "comando": "apt search",
    "descricao": "Pesquisa pacotes disponíveis nos repositórios pelo nome ou palavra-chave.",
    "exemplo": "apt search nome"
  },
  {
    "id": "apt-show",
    "categoria": "pacotes",
    "comando": "apt show",
    "descricao": "Mostra detalhes de um pacote (versão, tamanho, descrição).",
    "exemplo": "apt show nomedoprograma"
  },
  {
    "id": "apt-list-installed",
    "categoria": "pacotes",
    "comando": "apt list --installed",
    "descricao": "Lista os pacotes instalados via APT, filtrando por nome com grep.",
    "exemplo": "apt list --installed | grep nome"
  },
  {
    "id": "dpkg-i",
    "categoria": "pacotes",
    "comando": "sudo dpkg -i",
    "descricao": "Instala um arquivo .deb baixado manualmente.",
    "exemplo": "sudo dpkg -i arquivo.deb"
  },
  {
    "id": "apt-f-install",
    "categoria": "pacotes",
    "comando": "sudo apt -f install",
    "descricao": "Corrige erros de dependência depois de instalar um .deb com dpkg.",
    "exemplo": "sudo apt -f install"
  },
  {
    "id": "dpkg-l-list",
    "categoria": "pacotes",
    "comando": "dpkg -L",
    "descricao": "Mostra onde os arquivos de um pacote .deb instalado ficaram espalhados pelo sistema.",
    "exemplo": "dpkg -L google-chrome-stable"
  },
  {
    "id": "dpkg-l-grep",
    "categoria": "pacotes",
    "comando": "dpkg -l | grep",
    "descricao": "Lista pacotes instalados filtrando pelo nome, quando não se sabe o nome exato do pacote.",
    "exemplo": "dpkg -l | grep code"
  },
  {
    "id": "dpkg-s",
    "categoria": "pacotes",
    "comando": "dpkg -S",
    "descricao": "Descobre a qual pacote instalado pertence um arquivo específico.",
    "exemplo": "dpkg -S /usr/bin/code"
  },
  {
    "id": "flatpak-install",
    "categoria": "pacotes",
    "comando": "flatpak install",
    "descricao": "Instala um programa pelo Flatpak, formato universal muito usado no Mint.",
    "exemplo": "flatpak install flathub nome-do-app"
  },
  {
    "id": "snap-install",
    "categoria": "pacotes",
    "comando": "sudo snap install",
    "descricao": "Instala um programa pelo Snap, similar ao Flatpak.",
    "exemplo": "sudo snap install nome-do-app"
  },
  {
    "id": "wget",
    "categoria": "pacotes",
    "comando": "wget",
    "descricao": "Baixa um arquivo direto da internet pelo terminal.",
    "exemplo": "wget https://link.com/arquivo"
  },
  {
    "id": "appimage-chmod",
    "categoria": "pacotes",
    "comando": "chmod +x arquivo.AppImage",
    "descricao": "Dá permissão de execução a um AppImage antes de rodá-lo. AppImage não se instala, roda direto de onde está.",
    "exemplo": "chmod +x nome-do-programa.AppImage"
  },
  {
    "id": "appimage-run",
    "categoria": "pacotes",
    "comando": "./arquivo.AppImage",
    "descricao": "Executa o AppImage depois de dar permissão com chmod +x.",
    "exemplo": "./nome-do-programa.AppImage"
  },
  {
    "id": "libfuse2",
    "categoria": "pacotes",
    "comando": "sudo apt install libfuse2",
    "descricao": "Corrige o erro de FUSE que alguns AppImages mais novos apresentam ao rodar.",
    "exemplo": "sudo apt install libfuse2"
  },
  {
    "id": "tab-autocomplete",
    "categoria": "atalhos-terminal",
    "comando": "Tab",
    "descricao": "Autocompleta comandos e nomes de arquivos. Duas vezes mostra todas as opções disponíveis.",
    "exemplo": "cd ~/Down<Tab>"
  },
  {
    "id": "setas-historico",
    "categoria": "atalhos-terminal",
    "comando": "↑ / ↓",
