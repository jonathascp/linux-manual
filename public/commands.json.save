    "id": "grep-arquivos",
    "categoria": "wildcards",
    "comando": "grep -l",
    "descricao": "Busca arquivos pelo conteúdo dentro deles, não pelo nome.",
    "exemplo": "grep -l \"erro\" *.log"
  },
