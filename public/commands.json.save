  {
    "id": "resolvectl",
    "categoria": "rede",
    "comando": "resolvectl status",
    "descricao": "Mostra quais servidores DNS estão configurados na máquina.",
    "exemplo": "resolvectl status"
  },
  {
    "id": "ss",
    "categoria": "rede",
    "comando": "ss -tulnp",
    "descricao": "Lista conexões de rede ativas e portas abertas na máquina. Substituiu o antigo netstat.",
    "exemplo": "ss -tulnp"
  },
  {
    "id": "nmcli-status",
    "categoria": "rede",
    "comando": "nmcli device status",
    "descricao": "Mostra o estado geral das interfaces de rede pela linha de comando.",
    "exemplo": "nmcli device status"
  },
